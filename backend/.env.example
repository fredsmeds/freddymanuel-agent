# Humunculous public agent — environment variables.
#
# Local dev:  copy this file to `backend/.env` and fill in the two keys.
# Render:     set these in the dashboard (Environment tab) as secret vars. NEVER commit real keys.

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # generation (Claude Sonnet 4.6)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx          # embeddings (text-embedding-3-small)

# Optional overrides:
# PORT=8011                                  # local port (Render injects its own $PORT)
# AGENT_RATE_LIMIT=20/10 minutes             # per-IP rate limit
# EXTRA_ALLOWED_ORIGINS=https://example.com  # extra exact CORS origins, comma-separated
# ALLOWED_ORIGIN_REGEX=https://([a-z0-9-]+\.)?freddymanuel-rebuild\.pages\.dev  # override preview regex
